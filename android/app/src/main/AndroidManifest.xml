<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet + calls + biometrics. No READ_CONTACTS / SMS / location: we don't want them. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Catch the secret dial code typed in the system dialer. -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS"/>

    <application
        android:label="Calculator"
        android:icon="@mipmap/ic_decoy"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Single Flutter activity. It is NOT itself a launcher; the alias below is. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"/>

        <!-- DECOY launcher: what shows in the app drawer. Looks like a calculator. -->
        <activity-alias
            android:name=".DecoyLauncher"
            android:targetActivity=".MainActivity"
            android:label="Calculator"
            android:icon="@mipmap/ic_decoy"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- REAL launcher alias, disabled by default. Can be enabled at runtime if the user
             wants a normal visible icon instead of the decoy. -->
        <activity-alias
            android:name=".RealLauncher"
            android:targetActivity=".MainActivity"
            android:label="wow-chat"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Secret dial-code receiver: dialing *#*#7469#*#* in the phone app opens wow-chat. -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.NEW_OUTGOING_CALL"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
